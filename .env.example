# Environment variables for local development
# Copy this file to .env and update values as needed

# Server Configuration
SERVER_PORT=8080

# MongoDB Configuration
MONGODB_URI=mongodb://admin:changeThisPassword@localhost:27017
MONGODB_DATABASE=focusapp

# MongoDB Docker Configuration (used by docker-compose.yml)
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=changeThisPassword
MONGO_DATABASE=focusapp

# Mongo Express Configuration
MONGO_EXPRESS_USERNAME=admin
MONGO_EXPRESS_PASSWORD=changeThisPassword

# JWT Configuration (IMPORTANT: Change in production!)
JWT_SECRET=your-very-secure-secret-key-change-this-in-production-minimum-256-bits-long-for-HS256
JWT_EXPIRATION=86400000

# Application Configuration
SPRING_PROFILES_ACTIVE=dev
